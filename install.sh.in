#!/usr/bin/env bash
# xui-mult installer — per-inbound traffic multiplier for 3X-UI (verified on v3.8.5)
# Usage:  bash install.sh            install or upgrade
#         bash install.sh uninstall  remove (panel clients are not touched)
set -euo pipefail

VERSION="__VERSION__"
APP_DIR=/usr/local/xui-mult
CONF_DIR=/etc/xui-mult
UNIT=/etc/systemd/system/xui-mult.service
BIN=/usr/local/bin/xui-mult
XUI_DB="${XUI_DB:-/etc/x-ui/x-ui.db}"

red()   { printf '\033[31m%s\033[0m\n' "$*"; }
green() { printf '\033[32m%s\033[0m\n' "$*"; }
yellow(){ printf '\033[33m%s\033[0m\n' "$*"; }
die()   { red "✖ $*"; exit 1; }

[[ $EUID -eq 0 ]] || die "run as root:  sudo bash install.sh"

if [[ "${1:-}" == "uninstall" ]]; then
  if [[ -x $BIN ]]; then exec "$BIN" uninstall; fi
  systemctl disable --now xui-mult 2>/dev/null || true
  rm -f "$UNIT" "$BIN"; rm -rf "$APP_DIR"; systemctl daemon-reload || true
  green "✔ removed"; exit 0
fi

echo "xui-mult $VERSION installer"
command -v systemctl >/dev/null || die "systemd is required"

# --- python3 >= 3.9 (standard library only)
if ! command -v python3 >/dev/null; then
  yellow "• installing python3"
  if command -v apt-get >/dev/null; then apt-get update -qq && apt-get install -y -qq python3 >/dev/null
  elif command -v dnf >/dev/null; then dnf install -y -q python3
  elif command -v yum >/dev/null; then yum install -y -q python3
  else die "please install python3 (>= 3.9) first"; fi
fi
PY=$(command -v python3)
"$PY" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' || die "python3 >= 3.9 required ($("$PY" -V))"
"$PY" -c 'import sqlite3, ssl' 2>/dev/null || die "python3 is missing sqlite3/ssl modules"

# --- 3X-UI checks
[[ -f $XUI_DB ]] || die "3X-UI database not found at $XUI_DB (set XUI_DB=/path/x-ui.db). PostgreSQL panels are not supported."
PANEL_VER=$(/usr/local/x-ui/x-ui -v 2>/dev/null </dev/null | head -1 || true)
if [[ -n $PANEL_VER && $PANEL_VER != *3.8.5* ]]; then
  yellow "! panel reports '$PANEL_VER' — xui-mult was verified on 3X-UI v3.8.5."
  yellow "  It checks the database layout at start-up and refuses to run if it is incompatible."
fi

# --- files
mkdir -p "$APP_DIR" "$CONF_DIR"
chmod 700 "$CONF_DIR"
TMP=$(mktemp "$APP_DIR/.xui_mult.XXXXXX")
base64 -d > "$TMP" <<'__PAYLOAD_EOF__'
__PAYLOAD__
__PAYLOAD_EOF__
"$PY" -m py_compile "$TMP" || die "payload corrupted"
chmod 755 "$TMP"
mv -f "$TMP" "$APP_DIR/xui_mult.py"
rm -rf "$APP_DIR/__pycache__"
cat > "$BIN" <<EOF
#!/bin/sh
exec "$PY" "$APP_DIR/xui_mult.py" "\$@"
EOF
chmod 755 "$BIN"

if [[ ! -f $CONF_DIR/config.json ]]; then
  "$PY" - "$XUI_DB" "$CONF_DIR/config.json" <<'PYEOF'
import json, sys
cfg = {"db": sys.argv[1], "api_url": "", "api_token": "", "link_host": "", "api_host": "auto",
       "verify_tls": "auto", "interval": 7, "sub_link": True, "pairs": []}
open(sys.argv[2], "w").write(json.dumps(cfg, indent=2) + "\n")
PYEOF
fi
chmod 600 "$CONF_DIR/config.json"

# --- systemd service
cat > "$UNIT" <<EOF
[Unit]
Description=xui-mult: per-inbound traffic multiplier for 3X-UI
Documentation=https://github.com/MHSanaei/3x-ui/issues/5791
After=network-online.target x-ui.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
ExecStart=$PY $APP_DIR/xui_mult.py run
ExecReload=/bin/kill -HUP \$MAINPID
Restart=always
RestartSec=5
WatchdogSec=120
TimeoutStopSec=20
RuntimeDirectory=xui-mult
RuntimeDirectoryPreserve=yes
Environment=PYTHONUNBUFFERED=1
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable xui-mult >/dev/null 2>&1
systemctl restart xui-mult
sleep 1
if systemctl is-active --quiet xui-mult; then green "✔ service xui-mult is running"; else
  yellow "! service did not start yet — check: xui-mult logs"; fi

green "✔ installed xui-mult $VERSION"
echo
if ! grep -q '"api_token": "[^"]' "$CONF_DIR/config.json"; then
  echo "Next: connect it to your panel (create an API token with FULL access in the panel first)."
  if { : </dev/tty; } 2>/dev/null; then
    read -r -p "Run setup now? [Y/n] " a </dev/tty 2>/dev/null || a=n
    if [[ -z $a || $a == [Yy]* ]]; then "$BIN" setup </dev/tty || true; fi
  fi
fi
echo "Open the menu any time with:  xui-mult"
